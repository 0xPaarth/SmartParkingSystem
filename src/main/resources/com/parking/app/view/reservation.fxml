<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.app.controller.ReservationController" styleClass="dashboard-view">
  <left><fx:include source="sidebar-nav.fxml"/></left>
  <center><VBox spacing="12" styleClass="dashboard-content">
    <Label text="Make a reservation" styleClass="page-title"/>
    <TextField fx:id="driverField" promptText="Driver ID"/>
    <DatePicker fx:id="datePicker" promptText="Date"/>
    <TextField fx:id="timeField" promptText="Time (HH:mm)"/>
    <ComboBox fx:id="slotBox" promptText="Select slot"/>
    <ListView fx:id="priceList" prefHeight="180"/>
    <Label fx:id="priceLabel" text="Estimated total: 0.00"/>
    <Button text="Confirm reservation" onAction="#confirm"/>
    <Label fx:id="resultLabel"/>
  </VBox></center>
</BorderPane>
