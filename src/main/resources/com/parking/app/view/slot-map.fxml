<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.app.controller.SlotMapController" styleClass="dashboard-view">
  <left><fx:include source="sidebar-nav.fxml"/></left>
  <center><VBox spacing="12" styleClass="dashboard-content">
    <Label text="Interactive slot map" styleClass="page-title"/>
    <HBox spacing="8"><Label text="Level"/><ComboBox fx:id="levelBox"/><Label text="Slot type"/><ComboBox fx:id="typeBox"/></HBox>
    <ListView fx:id="slotList" VBox.vgrow="ALWAYS"/>
    <Label fx:id="detailsLabel" text="Select a slot"/>
  </VBox></center>
</BorderPane>
