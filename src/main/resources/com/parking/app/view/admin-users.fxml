<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.app.controller.AdminUserManagementController">
  <top><HBox spacing="8"><Label text="User management" styleClass="page-title"/><Button text="Change role" onAction="#changeRole"/><Button text="Vehicle blacklist" onAction="#toggleBlacklist"/><Button text="Back" onAction="#back"/></HBox></top>
  <center><TableView fx:id="usersTable"><columns><TableColumn fx:id="idColumn" text="ID"/><TableColumn fx:id="nameColumn" text="Name"/><TableColumn fx:id="roleColumn" text="Role"/></columns></TableView></center>
</BorderPane>
