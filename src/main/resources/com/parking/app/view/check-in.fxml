<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.app.controller.CheckInController" styleClass="dashboard-view">
  <left><fx:include source="sidebar-nav.fxml"/></left>
  <center><VBox spacing="12" styleClass="dashboard-content">
    <Label text="Check in" styleClass="page-title"/>
    <TextField fx:id="lookupField" promptText="Reservation ID or plate"/>
    <Label fx:id="suggestionLabel" text="No slot suggestion"/>
    <Button text="Generate QR ticket" onAction="#generateTicket"/>
    <Label fx:id="ticketLabel"/>
  </VBox></center>
</BorderPane>
