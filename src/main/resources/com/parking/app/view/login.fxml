<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.parking.app.controller.LoginController"
      alignment="CENTER" spacing="12" styleClass="login-view">
  <Label text="Welcome back" styleClass="brand-title"/>
  <Label text="Sign in with a seeded user ID to preview a role dashboard." styleClass="subtitle"/>
  <TextField fx:id="userIdField" promptText="User ID (for example, driver-1)" maxWidth="320"/>
  <Label fx:id="errorLabel" styleClass="error-label"/>
  <Button text="Log in" onAction="#login" defaultButton="true"/>
  <Button text="Back" onAction="#backToSplash" styleClass="secondary-button"/>
</VBox>
